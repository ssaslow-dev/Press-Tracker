+    # ---------- PROQUESTPDF-v1: a ProQuest article's text is the saved copy; its PDF (files/<id>.pdf in the update folder) is kept as the original ----------
+    @staticmethod
+    def pq_doc(p):
+        return isinstance(p, dict) and isinstance(p.get('pq'), dict) and bool(p['pq'].get('header') or p['pq'].get('docid') or p['pq'].get('file'))
+
+    def apply_pq_pdf(self, pid, p, aid, r, pages_dir):
+        """The saved copy is the story's text as HTML in the library's ProQuest-copy form (made by the Update station from the PDF),
+        <year>/pq<Article ID><o|r>-<Story ID>.html, File type "ProQuest pdf" (the sheet's own word for these copies, Data Source ProQuest). The PDF it was
+        read from is kept beside the originals, add-only: _original_pdf/<year>/pq<Article ID><o|r>-<Story ID>.pdf, checked against the checksum the page
+        gave. A missing or wrong PDF is reported and does not stop the text copy (the text is what the tracker and the reprint test read)."""
+        import os, hashlib
+        pq = p['pq']
+        suf = {'Original': 'o', 'Reprint': 'r'}.get(self.s.get(r, 'Original or reprint'), '')
+        st = str(self.s.get(r, 'Story ID') or '').strip()
+        stem = f'pq{aid}{suf}' + (f'-{st}' if st else '')
+        d = norm_val(self.s.get(r, 'Date'))
+        year = d[:4] if re.match(r'^\d{4}', d) else str(self.s.get(r, 'Year') or '')[:4] or self.today[:4]
+        info = {'page': pid, 'aid': aid, 'file': f'{year}/{stem}.html', 'url': p.get('url', ''), 'source': 'proquest pdf', 'status': 'proquest', 'flags': [], 'removed': 0,
+                'words': [None, None], 'header_conflicts': []}
+        chk = self.check_page(pid, {})
+        if chk['verdict'] == 'error':
+            self.fill(r, 'Saved Copy?', 'No', 'pages', pid)
+            self.res['pages_error'].append(dict(info, why=chk['reason']))
+            return
+        html = chk['html']
+        self.saved_html[aid] = html
+        raw = None
+        if pq.get('file'):
+            path = self.nb_pdf_path(pq)
+            raw = open(path, 'rb').read() if path else None
+            if raw is not None and hashlib.sha256(raw).hexdigest() != pq.get('pdf_sha256'):
+                raw = None
+            if raw is None:
+                info['flags'] = ['pdf_missing']
+                self.res['pages_flagged'].append(dict(info, why='the ProQuest PDF is missing or does not match its checksum: the text copy is saved without it'))
+        if pages_dir:
+            os.makedirs(os.path.join(pages_dir, year), exist_ok=True)
+            with open(os.path.join(pages_dir, year, stem + '.html'), 'w', encoding='utf-8') as f:
+                f.write(html)
+            if raw is not None:
+                os.makedirs(os.path.join(pages_dir, '_original_pdf', year), exist_ok=True)
+                with open(os.path.join(pages_dir, '_original_pdf', year, stem + '.pdf'), 'wb') as f:
+                    f.write(raw)
+                info['original_pdf'] = f'_original_pdf/{year}/{stem}.pdf'
+        self.fill(r, 'Saved Copy?', 'Yes', 'pages', pid)
+        self.fill(r, 'File type', 'ProQuest pdf', 'pages', pid)
+        self.fill(r, 'File name', stem + '.html', 'pages', pid)
+        self.fill_counts(r, {'html': html}, pid)
+        self.res['pages'].append(info)
+
