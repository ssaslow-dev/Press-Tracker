+    def apply_print_new(self, pid, p, aid, r, pages_dir):
+        """PRINTNEW-v1: a newspaper page that carries a NEW story (pages doc nb.kind 'print_page', nb.as 'new'). The pages doc's clean text is only that article's text as
+        Claude read it, headed "Text read from the newspaper page by Claude". It is the story's saved copy, written as the library names a web copy,
+        <year>/ws<Article ID><o|r>-<Story ID>.html (add-only; a row that already has a saved copy is left alone); Saved Copy?, File type, File name and the text-derived
+        counts are filled (blank cells only). The page scan is kept by apply_print_pages as the print original. Word count: the row's own (the station's, from the
+        reading) stays; it is only filled when blank."""
+        import os
+        nb = p.get('nb') or {}
+        html = p.get('clean') or ''
+        suf = {'Original': 'o', 'Reprint': 'r'}.get(self.s.get(r, 'Original or reprint'), '')
+        st = str(self.s.get(r, 'Story ID') or '').strip()
+        fname = f'ws{aid}{suf}' + (f'-{st}' if st else '') + '.html'
+        year = self._year_of(self.s.get(r, 'Date'), self.s.get(r, 'Year'))
+        info = {'page': pid, 'aid': aid, 'file': f'{year}/{fname}', 'url': '', 'source': 'print page read by Claude', 'status': 'print page',
+                'flags': list(nb.get('flags') or []), 'removed': 0, 'words': [None, None], 'header_conflicts': []}
+        have = norm_val(self.s.get(r, 'File name'))
+        if have and have not in (RETRY, BLOCKED):
+            self.res['pages_skipped'].append(dict(info, why='the row already has a saved copy (' + have + '): the read text is not saved'))
+            return
+        lib = getattr(self, 'library_dir', None)
+        if lib and os.path.exists(os.path.join(lib, year, fname)):
+            self.res['pages_skipped'].append(dict(info, why='that file name is already in the library: not replaced'))
+            return
+        self.saved_html[aid] = html
+        if pages_dir:
+            os.makedirs(os.path.join(pages_dir, year), exist_ok=True)
+            with open(os.path.join(pages_dir, year, fname), 'w', encoding='utf-8') as f:
+                f.write(html)
+        if have in (RETRY, BLOCKED):
+            self.res.setdefault('retry_cleared', []).append({'aid': aid, 'was': have, 'file': f'{year}/{fname}'})
+            for col in ('File name', 'Saved Copy?'):
+                self.s.ws.cell(r, self.s.col[col]).value = None
+        self.fill(r, 'Saved Copy?', 'Yes', 'pages', pid)
+        self.fill(r, 'File type', 'HTML', 'pages', pid)
+        self.fill(r, 'File name', fname, 'pages', pid)
+        self.fill_counts(r, {'html': html}, pid, words=blank(self.s.get(r, 'Word count')))
+        self.res['pages'].append(info)
+
+    def _page_aid(self, pid):
+        """the Article ID of the row a pages document belongs to (the same lookup apply_pages uses), or None"""
+        target = self.norm_id(self.page_target.get(pid) or self.ids.get(pid, pid))
+        if target in self.s.rows:
+            return target
+        r = self.s.original_row(self.resolve_sid(target))
+        return self.s.get(r, 'Article ID') if r else None
+
