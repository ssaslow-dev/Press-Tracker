+/* 1. the navy table header meets the card border (at rest and pinned; square while pinned: STUCKCORNER-v1) */
+@supports (overflow-clip-margin:1px){
+:root .card>.tablewrap{overflow:clip;overflow-clip-margin:1px}
+:root .card>.tablewrap>table.db>thead>tr>th::before{content:"";position:absolute;z-index:-1;inset:-1px 0 0 0;background:var(--navy);pointer-events:none}
+:root .card>.tablewrap>table.db>thead>tr>th:first-child::before{left:-1px;border-top-left-radius:10px}
+:root .card>.tablewrap>table.db>thead>tr>th:last-child::before{right:-1px;border-top-right-radius:10px}
+:root .card>.tablewrap>table.db.hdr-stuck>thead>tr>th::before{border-radius:0}
+}
+/* 2. a list tab never grows wider than the window; Outlets and Reporters drop their least needed columns instead */
+:root .tt>.tt-head,:root .tt>.grid-clips{min-width:0}
