+:root .tt[data-tt-id="outlets"] .card>.tablewrap>table.db>thead>tr>th:nth-child(9)::before{right:-1px;border-top-right-radius:10px}
+:root .tt[data-tt-id="outlets"] .card>.tablewrap>table.db.hdr-stuck>thead>tr>th:nth-child(9)::before{border-radius:0}}
+@media (min-width:761px) and (max-width:859px){:root .tt[data-tt-id="outlets"] table.db :is(th,td):is(:nth-child(5),:nth-child(6)){display:none}}
+@media (min-width:761px) and (max-width:999px){:root .tt[data-tt-id="reporters"] table.db :is(th,td):nth-child(4){display:none}}
