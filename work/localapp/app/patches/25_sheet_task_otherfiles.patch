+                seen.add(key)
+                skip = lambda why, rid=rid, aid=aid, fid=fid: self.res['other_files_skipped'].append({'run': rid, 'aid': aid, 'file': fid, 'why': why})
+                r = self.s.rows.get(aid)
+                if r is None:
+                    skip('the row is not in the workbook')
+                    continue
+                fmt = str(x.get('fmt') or '')
+                is_print = x.get('kind') == 'print'      # PRINTORIG-v1 (option B): a page scan, named <Print Article ID>_p<pages>.pdf, found by that name (no column)
+                if not is_print and fmt not in ('nb', 'pq'):
