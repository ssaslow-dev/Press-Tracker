+                if raw is None or hashlib.sha256(raw).hexdigest() != x.get('pdf_sha256'):
+                    skip('the PDF is missing or does not match its checksum')
+                    continue
+                to_file2 = not is_print and x.get('to') == 'file2_else_other' and 'File name 2' in self.s.col and blank(self.s.get(r, 'File name 2'))
+                if not (to_file2 or have_col or is_print):
+                    skip('the workbook has no "Other files" column yet')
+                    continue
+                idcol = 'Print Article ID' if (x.get('id_col') == 'Print Article ID' or is_print) and norm_val(self.s.get(r, 'Print Article ID')) else 'Article ID'
+                num = norm_val(self.s.get(r, idcol)) or aid
+                suf = {'Original': 'o', 'Reprint': 'r'}.get(self.s.get(r, 'Original or reprint'), '')
+                st = str(self.s.get(r, 'Story ID') or '').strip()
+                stem = f'{fmt}{num}{suf}' + (f'-{st}' if st else '')
+                if is_print:
+                    stem = f'{num}_p{x["pages"]}'
+                d = norm_val(self.s.get(r, 'Date'))
+                year = d[:4] if re.match(r'^\d{4}', d) else str(self.s.get(r, 'Year') or '')[:4] or self.today[:4]
+                held = set()
+                for c in ('File name', 'File name 2', self.OTHER_COL):
+                    if c in self.s.col:
+                        held |= set(self.file_names(self.s.get(r, c)))
+                lib = getattr(self, 'library_dir', None)
