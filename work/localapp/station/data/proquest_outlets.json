{
 "id": "PROQUESTPDF-v1 outlet names",
 "version": 1,
 "about": "Built by tools/build_pq_aliases.py from data/proquest_outlets_curated.json (rules and hand-kept pairs), code/outlet_rules.json (the tracker's own folding) and the workbook's ProQuest rows. How a ProQuest PDF's outlet is named: (1) clean_rules turn the Publication title into a name (text before ';', edition and '(Online)' suffixes off); (2) the name gets a key: key_steps then the PC's feeds and aliases then key_post (exact = before the PC aliases, fold = after); (3) a pair (below) wins; a generic name (generic_needs_city) with no pair for its place is never matched; else the tracker's own spelling for the same exact key, then the same fold key; else the cleaned name is kept and the row's Team note says 'outlet name from ProQuest; check'. Nothing is guessed.",
 "inputs": {
  "outlet_rules_sha256": "0b3a6850c62aa1b76ae8d93f105f6da8c3f20ede08c58e09c70bf3e10ded6cb1",
  "curated_sha256": "707293416701ff628bd33ec30e3206b3bce62fc30b9b52d4819b48f4b1462bca",
  "workbook_rows": 8193,
  "proquest_rows": 336,
  "proquest_html_copies": 460
 },
 "clean_rules": [
  {
   "id": "edition",
   "rx": ",\\s*(?:late|early|final|national|metro|west|east|home|city|sunday|bulk|eastern|western|regional)\\b[^;]*?edition[^;]*$",
   "to": "",
   "flags": "i",
   "source": "existing pqparse.outletOf; ProQuest naming pattern 'New York Times, Late Edition (East Coast)', 'Wall Street Journal, Eastern edition'",
   "note": "drops the edition suffix"
  },
  {
   "id": "online",
   "rx": "\\s*\\((?:online|print|ed\\.|east coast|west coast)[^)]*\\)\\s*$",
   "to": "",
   "flags": "i",
   "source": "existing pqparse.outletOf; ProQuest naming pattern 'Los Angeles Times (Online)'",
   "note": "drops '(Online)', '(Print)', '(East Coast)' ..."
  },
  {
   "id": "historical",
   "rx": "\\s*\\((?:pre-\\d{4}[^)]*|\\d{4}\\s*-[^)]*)\\)\\s*$",
   "to": "",
   "flags": "i",
   "source": "ProQuest naming pattern for historical files, 'Wall Street Journal (1923 - Current file)', 'Los Angeles Times (pre-1997 Fulltext)'. Not seen in this workbook; written from ProQuest's documented title style, so check it on the first real PDF",
   "note": "drops the years-covered note"
  },
  {
   "id": "bracket",
   "rx": "\\s*\\[[^\\]]*\\]\\s*$",
   "to": "",
   "flags": "i",
   "source": "existing pqparse.outletOf: a trailing [..] label",
   "note": "drops '[subscription]'-style labels"
  },
  {
   "id": "tail_punct",
   "rx": "[,.]\\s*$",
   "to": "",
   "flags": "",
   "source": "existing pqparse.outletOf",
   "note": "drops a trailing comma or period"
  }
 ],
 "key_steps": [
  {
   "id": "blogs",
   "rx": "\\s*:\\s*blogs\\s*$",
   "to": "",
   "source": "code/sheet_task.py _outlet_base (OUTLETRULES-v1)"
  },
  {
   "id": "todays_edition",
   "rx": "\\s*\\(?\\btoday'?s edition\\b\\)?",
   "to": "",
   "source": "code/sheet_task.py _outlet_base"
  },
  {
   "id": "article_last_to_first",
   "rx": "^(.*?),\\s*(el|la|le|les|il|der|die|das)\\s*$",
   "to": "$2 $1",
   "source": "NewsBank files foreign names 'Mundo, El' / 'Presse Canadienne, La' (5 and 1 rows in the snapshot); ProQuest writes 'El Mundo'. Moved to the front here, removed in key_post, so both read the same",
   "note": "only a comma + article at the very end"
  },
  {
   "id": "the_last",
   "rx": ",\\s*the(?=\\s*(?::|/|$))",
   "to": "",
   "source": "code/sheet_task.py _outlet_base"
  },
  {
   "id": "the_first",
   "rx": "^the\\s+",
   "to": "",
   "source": "code/sheet_task.py _outlet_base"
  },
  {
   "id": "punct",
   "rx": "[^a-z0-9]+",
   "to": " ",
   "source": "code/sheet_task.py _outlet_base"
  }
 ],
 "key_post": [
  {
   "id": "article_first",
   "rx": "^(?:el|la|le|les|il|der|die|das|l)\\s+(?=\\S)",
   "to": "",
   "source": "same note as article_last_to_first. Runs after the PC's feeds and aliases, so 'el pais ...' aliases still work"
  }
 ],
