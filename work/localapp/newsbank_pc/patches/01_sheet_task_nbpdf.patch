+    # ---------- NEWSBANKPDF-v1: a NewsBank story's own PDF (files/<id>.pdf in the update folder) is the saved copy ----------
+    @staticmethod
+    def nb_doc(p):
+        return isinstance(p, dict) and isinstance(p.get('nb'), dict) and bool(p['nb'].get('docref') or p['nb'].get('file'))
+
+    def nb_pdf_path(self, nb):
+        import os
+        fid = os.path.basename(str(nb.get('file') or ''))
+        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,119}\.pdf', fid) or not getattr(self, 'db_dir', None):
+            return None
+        pth = os.path.join(self.db_dir, 'files', fid)
+        return pth if os.path.isfile(pth) else None
+
+    def apply_nb_pdf(self, pid, p, aid, r, pages_dir):
+        """Save the PDF as <year>/nb<Article ID><o|r>-<Story ID>.pdf (the library's NewsBank name), fill Saved Copy? / File type / File name and the
+        text-derived cells from the story's own text. A story with no PDF (a citation page only) gets Saved Copy? No and no file (DECISIONS 2026-10-27)."""
+        import os, hashlib
+        nb = p['nb']
+        suf = {'Original': 'o', 'Reprint': 'r'}.get(self.s.get(r, 'Original or reprint'), '')
+        st = str(self.s.get(r, 'Story ID') or '').strip()
+        fname = f'nb{aid}{suf}' + (f'-{st}' if st else '') + '.pdf'
+        d = norm_val(self.s.get(r, 'Date'))
+        year = d[:4] if re.match(r'^\d{4}', d) else str(self.s.get(r, 'Year') or '')[:4] or self.today[:4]
+        info = {'page': pid, 'aid': aid, 'file': f'{year}/{fname}', 'url': p.get('url', ''), 'source': 'newsbank pdf', 'status': 'newsbank', 'flags': [], 'removed': 0,
+                'words': [None, None], 'header_conflicts': []}
+        if not nb.get('file'):
+            self.fill(r, 'Saved Copy?', 'No', 'pages', pid)
+            self.res.setdefault('pages_skipped', []).append(dict(info, why='NewsBank citation page only: no saved copy'))
+            return
+        path = self.nb_pdf_path(nb)
+        raw = open(path, 'rb').read() if path else None
+        if raw is None or hashlib.sha256(raw).hexdigest() != nb.get('pdf_sha256'):
+            self.fill(r, 'Saved Copy?', 'No', 'pages', pid)
+            self.res['pages_error'].append(dict(info, why='the NewsBank PDF is missing or does not match its checksum: no saved copy'))
+            return
+        html = p.get('clean') or ''
+        self.saved_html[aid] = html
+        if pages_dir:
+            os.makedirs(os.path.join(pages_dir, year), exist_ok=True)
+            with open(os.path.join(pages_dir, year, fname), 'wb') as f:
+                f.write(raw)
+        self.fill(r, 'Saved Copy?', 'Yes', 'pages', pid)
+        self.fill(r, 'File type', 'Newsbank pdf', 'pages', pid)
+        self.fill(r, 'File name', fname, 'pages', pid)
+        self.fill_counts(r, {'html': html}, pid, words=blank(self.s.get(r, 'Word count')))   # a NewsBank row keeps NewsBank's own word count
+        self.res['pages'].append(info)
